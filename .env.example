# Kopieren nach .env.local und Werte eintragen. Werden beim Build in das JS eingebettet (öffentlich sichtbar).

# Webhook, an den jede Anfrage als JSON gepostet wird (Make, n8n, Zapier, HubSpot, Formspree …).
# Der Endpoint muss CORS für die Domain der Landingpage erlauben. Leer = Übermittlung wird nur simuliert.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# Buchungslink für Termine, z. B. https://calendly.com/entercon/erstanalyse. Leer = Termin-Buttons ausgeblendet.
NEXT_PUBLIC_CALENDLY_URL=
